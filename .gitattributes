# Golden files are compared byte for byte, and bank files' line endings are
# part of their format, so Git never converts them (D-091). The same goes
# for the exporters' golden files (D-099).
crates/kassensturz-import/tests/golden/** -text
crates/kassensturz-export/tests/golden/** -text

# The five-year Space Colony book is a database file (D-270).
crates/kassensturz-import/tests/books/** -text

# An example plugin's .wasm is packed from the JSON files beside it, and a
# test checks the bytes match (#791), so Git never converts their line
# endings either, not even on Windows.
examples/plugins/** -text
