# Rust / Cargo
/target/
**/target/
Cargo.lock.bak

# Cargo's downloads when building in the KDE SDK with tools/sdk.sh
/.sdk-cache/

# Cargo's folder in the Kubuntu and Fedora CI jobs (D-110)
/.cargo-home/

# The commit id CI writes before the Flatpak build (crates/kassensturz-ui-bridge/build.rs)
/build-commit
/build-commit-from
/build-version

# Written by the release workflow for a tag: switches the setup wizard's bank
# offer on (CMakeLists.txt, D-546)
/wizard-bank

# A FinTS product registration number for a build (crates/kassensturz-bank/build.rs,
# D-745). Never committed: the release workflow writes it from a secret, and
# whoever builds with their own registration writes their own.
/fints-registration

# flatpak-builder's state
/.flatpak-builder/

# cxx-qt / CMake build output
/build/
**/build/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json

# Qt / QML tooling artifacts
.qmlls.ini
*.qmlc
*.jsc
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.pro.user
*.pro.user.*

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo

# OS noise
.DS_Store
Thumbs.db

# Local book files a developer might open while testing (never real data, AGENTS.md §3.1 rule 2)
*.ksz
*.ksz-lock
