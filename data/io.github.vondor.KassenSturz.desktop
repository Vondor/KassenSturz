[Desktop Entry]
Type=Application
Name=KassenSturz
GenericName=Household Book
GenericName[de]=Haushaltsbuch
Comment=Keep track of your household's money
Comment[de]=Das Geld des Haushalts im Blick behalten
Exec=kassensturz
Icon=io.github.vondor.KassenSturz
# The window class Qt gives an X11 window, its name from the program; Wayland
# finds this file by the desktop file name the app sets (D-164).
StartupWMClass=kassensturz
Terminal=false
Categories=Qt;KDE;Office;Finance;
Keywords=money;finance;budget;bank;account;household;
Keywords[de]=Geld;Finanzen;Budget;Bank;Konto;Haushalt;
