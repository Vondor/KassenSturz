SPDX-License-Identifier: CC0-1.0

The manifest of KassenSturz's package for the Microsoft Store (#927, D-048).
windows-app.yml fills in @VERSION@ and packs the tested Windows files with it
(docs/WINDOWS.md). The identity values are the ones Partner Center gave the
reserved name; they are public (they sit in every package). The Store signs
the package itself, so CI builds it unsigned.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">
  <Identity
    Name="47425SerpentSoftware.KassenSturz-TheHouseholdBudge"
    Publisher="CN=734D2F8D-959F-4381-AD8C-FF9F9E9C279C"
    Version="@VERSION@"
    ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>KassenSturz - The Household Budget App</DisplayName>
    <PublisherDisplayName>SerpentSoftware</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
    <Resource Language="de-de" />
  </Resources>
  <Applications>
    <Application Id="KassenSturz" Executable="bin\kassensturz.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="KassenSturz"
        Description="Personal finance for everyday people"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- A stable command for a user's own AI tool (B-440, D-979): the
             path under WindowsApps changes with every update, this name
             does not. The tool starts `kassensturz-mcp` with no arguments;
             it then runs with the package's identity and settings. -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="bin\kassensturz-mcp.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="kassensturz-mcp.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
