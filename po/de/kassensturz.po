msgid "Other income"
msgstr "Sonstige Einnahmen"

#: crates/kassensturz-ui-bridge/qml/MockNotice.qml:18
#, kde-format
msgctxt "@info"
msgid ""
"This is a first draft of how KassenSturz starts. Try it with made-up "
"numbers: nothing is saved."
msgstr ""
"Das ist ein erster Entwurf, wie KassenSturz beginnt. Probieren Sie es mit "
"ausgedachten Zahlen aus: Nichts wird gespeichert."

