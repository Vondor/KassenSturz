#: crates/kassensturz-ui-bridge/qml/AccountPage.qml:33
#, kde-format
msgctxt "@item:inlistbox an account type"
msgid "Checking account"
msgstr "Girokonto"

#: crates/kassensturz-ui-bridge/qml/AccountPage.qml:34
#, kde-format
msgctxt "@info"
msgid "The account your pay goes into and your bills are paid from."
msgstr ""
"Das Konto, auf das Ihr Gehalt kommt und von dem Sie Rechnungen bezahlen."

#: crates/kassensturz-ui-bridge/qml/AccountPage.qml:38
#, kde-format
msgctxt "@item:inlistbox an account type"
msgid "Savings account"
msgstr "Sparkonto"

#: crates/kassensturz-ui-bridge/qml/AccountPage.qml:39
#, kde-format
msgctxt "@info"
msgid "Money you put aside."
msgstr "Geld, das Sie zurücklegen."

#: crates/kassensturz-ui-bridge/qml/AccountPage.qml:43
#, kde-format
msgctxt "@item:inlistbox an account type"
msgid "Cash"
msgstr "Bargeld"

#: crates/kassensturz-ui-bridge/qml/AccountPage.qml:44
#, kde-format
msgctxt "@info"
msgid "The money in your wallet."
msgstr "Das Geld in Ihrem Portemonnaie."

#: crates/kassensturz-ui-bridge/qml/AccountPage.qml:48
#, kde-format
msgctxt "@item:inlistbox an account type"
msgid "Credit card"
msgstr "Kreditkarte"

#: crates/kassensturz-ui-bridge/qml/AccountPage.qml:49
#, kde-format
msgctxt "@info"
msgid ""
"What you buy with it, you pay back later. KassenSturz shows what you owe on "
"it."
msgstr ""
"Was Sie damit kaufen, zahlen Sie später zurück. KassenSturz zeigt, was Sie "
"darauf schulden."

#: crates/kassensturz-ui-bridge/qml/AccountPage.qml:56
#, kde-format
msgctxt "@title"
msgid "Your first account"
msgstr "Ihr erstes Konto"

#: crates/kassensturz-ui-bridge/qml/AccountPage.qml:57
#, kde-format
msgctxt "@title"
msgid "Add an account"
msgstr "Konto hinzufügen"

#: crates/kassensturz-ui-bridge/qml/AccountPage.qml:93
#, kde-format
msgctxt "@label"
msgid "What kind of account is it?"
msgstr "Was für ein Konto ist es?"

#: crates/kassensturz-ui-bridge/qml/AccountPage.qml:114
#, kde-format
msgctxt "@label:textbox"
msgid "Name:"
msgstr "Name:"

#: crates/kassensturz-ui-bridge/qml/AccountPage.qml:123
#, kde-format
msgctxt "@label:textbox"
msgid "How much do you owe on it today?"
msgstr "Wie viel schulden Sie darauf heute?"

#: crates/kassensturz-ui-bridge/qml/AccountPage.qml:124
#, kde-format
msgctxt "@label:textbox"
msgid "How much is in it today?"
msgstr "Wie viel ist heute darauf?"

#: crates/kassensturz-ui-bridge/qml/AccountPage.qml:125
#: crates/kassensturz-ui-bridge/qml/TransactionPage.qml:95
#, kde-format
msgctxt "@info:placeholder %1 is an example amount"
msgid "For example %1"
msgstr "Zum Beispiel %1"

#: crates/kassensturz-ui-bridge/qml/AccountPage.qml:132
#, kde-format
msgctxt "@info"
msgid "Leave it empty if there's nothing in it."
msgstr "Lassen Sie das Feld leer, wenn nichts darauf ist."

#: crates/kassensturz-ui-bridge/qml/AccountPage.qml:139
#: crates/kassensturz-ui-bridge/qml/OverviewPage.qml:60
#, kde-format
msgctxt "@action:button"
msgid "Add account"
msgstr "Konto hinzufügen"

#: crates/kassensturz-ui-bridge/qml/FormError.qml:31
#, kde-format
msgctxt "@info"
msgid "Type an amount."
msgstr "Geben Sie einen Betrag ein."

#: crates/kassensturz-ui-bridge/qml/FormError.qml:33
#, kde-format
msgctxt "@info %1 is an example amount"
msgid "This isn't an amount. Type it like this: %1"
msgstr "Das ist kein Betrag. Geben Sie ihn so ein: %1"

#: crates/kassensturz-ui-bridge/qml/FormError.qml:35
#, kde-format
msgctxt "@info"
msgid ""
"Amounts here have at most %1 decimal place. Leave out the extra ones; "
"nothing is rounded for you."
msgid_plural ""
"Amounts here have at most %1 decimal places. Leave out the extra ones; "
"nothing is rounded for you."
msgstr[0] ""
"Beträge haben hier höchstens %1 Nachkommastelle. Lassen Sie die übrigen weg; "
"es wird nichts für Sie gerundet."
msgstr[1] ""
"Beträge haben hier höchstens %1 Nachkommastellen. Lassen Sie die übrigen "
"weg; es wird nichts für Sie gerundet."

#: crates/kassensturz-ui-bridge/qml/FormError.qml:37
#, kde-format
msgctxt "@info"
msgid "This amount is too large. Check it for extra digits."
msgstr "Dieser Betrag ist zu groß. Prüfen Sie, ob eine Ziffer zu viel ist."

#: crates/kassensturz-ui-bridge/qml/FormError.qml:39
#, kde-format
msgctxt "@info"
msgid ""
"Type an amount above zero. Whether you paid or received it, you choose above."
msgstr ""
"Geben Sie einen Betrag über null ein. Ob Sie bezahlt oder erhalten haben, "
"wählen Sie oben."

#: crates/kassensturz-ui-bridge/qml/FormError.qml:41
#, kde-format
msgctxt "@info"
msgid "Type what you owe without a minus sign."
msgstr "Geben Sie ohne Minuszeichen ein, was Sie schulden."

#: crates/kassensturz-ui-bridge/qml/FormError.qml:43
#, kde-format
msgctxt "@info %1 is an example date"
msgid "This isn't a date. Type it like this: %1"
msgstr "Das ist kein Datum. Geben Sie es so ein: %1"

#: crates/kassensturz-ui-bridge/qml/FormError.qml:45
#, kde-format
msgctxt "@info"
msgid "This choice isn't there anymore. Choose again."
msgstr "Diese Auswahl gibt es nicht mehr. Wählen Sie bitte neu."

#: crates/kassensturz-ui-bridge/qml/FormError.qml:47
#, kde-format
msgctxt "@info"
msgid "Give the account a name."
msgstr "Geben Sie dem Konto einen Namen."

#: crates/kassensturz-ui-bridge/qml/FormError.qml:49
#, kde-format
msgctxt "@info %1 is the name of an account or category"
msgid ""
"%1 already has this name. Choose another one, so you can tell them apart."
msgstr ""
"%1 hat schon diesen Namen. Wählen Sie einen anderen, damit Sie beide "
"unterscheiden können."

#: crates/kassensturz-ui-bridge/qml/FormError.qml:51
#, kde-format
msgctxt "@info %1 is an error code"
msgid "Something went wrong (%1). Please report this, so it can be fixed."
msgstr ""
"Etwas ist schiefgegangen (%1). Bitte melden Sie das, damit es behoben werden "
"kann."

#: crates/kassensturz-ui-bridge/qml/Main.qml:41
#, kde-format
