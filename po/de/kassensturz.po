msgid "Clothes"
msgstr "Kleidung"

#: crates/kassensturz-ui-bridge/qml/Main.qml:46
#, kde-format
msgctxt "@item a spending category"
msgid "Free time"
msgstr "Freizeit"

#: crates/kassensturz-ui-bridge/qml/Main.qml:47
#, kde-format
msgctxt "@item a spending category"
msgid "Other spending"
msgstr "Sonstige Ausgaben"

#: crates/kassensturz-ui-bridge/qml/Main.qml:49
#, kde-format
