#: crates/kassensturz-ui-bridge/qml/AccountDetailsPage.qml:60
#: crates/kassensturz-ui-bridge/qml/ImportDonePage.qml:63
#, kde-format
msgctxt "@label %1 is an amount of money"
msgid "you owed %1"
msgstr "Sie schuldeten %1"

#: crates/kassensturz-ui-bridge/qml/AccountDetailsPage.qml:90
#, kde-format
msgctxt "@info"
msgid ""
"This account is closed. It keeps its history, but takes no new transactions."
msgstr ""
"Dieses Konto ist geschlossen. Es behält seine Buchungen, nimmt aber keine "
"neuen mehr an."

#: crates/kassensturz-ui-bridge/qml/AccountDetailsPage.qml:119
#, kde-format
msgctxt "@info %1 is a date, %2 says how much money there was or was owed"
msgid "On %1 your bank said %2, and KassenSturz agrees."
msgstr "Am %1 stand bei Ihrer Bank: %2. KassenSturz sieht das genauso."

#: crates/kassensturz-ui-bridge/qml/AccountDetailsPage.qml:130
#, kde-format
msgctxt ""
"@info %1 is a date, %2 and %3 say how much money there was or was owed"
msgid ""
"On %1 your bank said %2, but KassenSturz now has %3 for that day. A "
"transaction dated before that day may have changed it. Check against your "
"bank to put it right."
msgstr ""
"Am %1 stand bei Ihrer Bank: %2. KassenSturz hat für diesen Tag aber jetzt "
"%3. Eine Buchung vor diesem Tag kann das geändert haben. Gleichen Sie das "
"Konto mit Ihrer Bank ab, um es richtigzustellen."

#: crates/kassensturz-ui-bridge/qml/AccountDetailsPage.qml:134
#: crates/kassensturz-ui-bridge/qml/AccountDetailsPage.qml:181
#: crates/kassensturz-ui-bridge/qml/TransactionPage.qml:170
#, kde-format
msgctxt "@action:button"
msgid "Check against my bank…"
msgstr "Mit der Bank abgleichen…"

#: crates/kassensturz-ui-bridge/qml/AccountDetailsPage.qml:144
#, kde-format
msgctxt "@title"
msgid "Name"
msgstr "Name"

#: crates/kassensturz-ui-bridge/qml/AccountDetailsPage.qml:157
#, kde-format
msgctxt "@label:textbox"
msgid "Name of the account"
msgstr "Name des Kontos"

#: crates/kassensturz-ui-bridge/qml/AccountDetailsPage.qml:161
#, kde-format
msgctxt "@action:button"
msgid "Rename"
msgstr "Umbenennen"

#: crates/kassensturz-ui-bridge/qml/AccountDetailsPage.qml:170
#, kde-format
msgctxt "@title"
msgid "Check against my bank"
msgstr "Mit der Bank abgleichen"

#: crates/kassensturz-ui-bridge/qml/AccountDetailsPage.qml:176
#, kde-format
msgctxt "@info"
msgid ""
"Type what your bank says is in the account on a day, and KassenSturz tells "
"you whether it agrees, and if not, where the difference can come from."
msgstr ""
"Geben Sie ein, was Ihre Bank an einem Tag auf dem Konto ausweist. "
"KassenSturz sagt Ihnen, ob es übereinstimmt und, wenn nicht, woher der "
"Unterschied kommen kann."

#: crates/kassensturz-ui-bridge/qml/AccountDetailsPage.qml:190
#, kde-format
msgctxt "@title"
msgid "Open again"
msgstr "Wieder öffnen"

#: crates/kassensturz-ui-bridge/qml/AccountDetailsPage.qml:190
#, kde-format
msgctxt "@title"
msgid "Close account"
msgstr "Konto schließen"

#: crates/kassensturz-ui-bridge/qml/AccountDetailsPage.qml:198
#, kde-format
msgctxt "@info"
msgid "Open the account again to add transactions to it."
msgstr "Öffnen Sie das Konto wieder, um Buchungen hinzuzufügen."

#: crates/kassensturz-ui-bridge/qml/AccountDetailsPage.qml:200
#, kde-format
msgctxt "@info"
msgid ""
"A closed account keeps its history, but takes no new transactions and leaves "
"your list. You can open it again any time."
msgstr ""
"Ein geschlossenes Konto behält seine Buchungen, nimmt aber keine neuen mehr "
"an und verschwindet aus Ihrer Liste. Sie können es jederzeit wieder öffnen."

#: crates/kassensturz-ui-bridge/qml/AccountDetailsPage.qml:201
#, kde-format
msgctxt "@info"
msgid ""
"You can close an account when nothing is left in it, so no money is hidden. "
"Move what is left to another account first."
msgstr ""
"Sie können ein Konto schließen, wenn nichts mehr darauf ist, damit kein Geld "
"versteckt wird. Buchen Sie den Rest vorher auf ein anderes Konto um."

#: crates/kassensturz-ui-bridge/qml/AccountDetailsPage.qml:206
#, kde-format
msgctxt "@action:button"
msgid "Open account again"
msgstr "Konto wieder öffnen"

#: crates/kassensturz-ui-bridge/qml/AccountDetailsPage.qml:206
#, kde-format
msgctxt "@action:button"
msgid "Close account"
msgstr "Konto schließen"

#: crates/kassensturz-ui-bridge/qml/AccountTypes.qml:21
#, kde-format
msgctxt "@item:inlistbox an account type"
msgid "Checking account"
msgstr "Girokonto"

#: crates/kassensturz-ui-bridge/qml/AccountTypes.qml:22
#, kde-format
msgctxt "@info"
msgid "The account your pay goes into and your bills are paid from."
msgstr ""
"Das Konto, auf das Ihr Gehalt kommt und von dem Sie Rechnungen bezahlen."

#: crates/kassensturz-ui-bridge/qml/AccountTypes.qml:26
#, kde-format
msgctxt "@item:inlistbox an account type"
msgid "Savings account"
msgstr "Sparkonto"

#: crates/kassensturz-ui-bridge/qml/AccountTypes.qml:27
#, kde-format
msgctxt "@info"
msgid "Money you put aside."
msgstr "Geld, das Sie zurücklegen."

#: crates/kassensturz-ui-bridge/qml/AccountTypes.qml:31
#, kde-format
msgctxt "@item:inlistbox an account type"
msgid "Cash"
msgstr "Bargeld"

#: crates/kassensturz-ui-bridge/qml/AccountTypes.qml:32
#, kde-format
msgctxt "@info"
msgid "The money in your wallet."
msgstr "Das Geld in Ihrem Portemonnaie."

#: crates/kassensturz-ui-bridge/qml/AccountTypes.qml:36
#, kde-format
msgctxt "@item:inlistbox an account type"
msgid "Credit card"
msgstr "Kreditkarte"

#: crates/kassensturz-ui-bridge/qml/AccountTypes.qml:37
#, kde-format
msgctxt "@info"
msgid ""
"What you buy with it, you pay back later. KassenSturz shows what you owe on "
"it."
msgstr ""
"Was Sie damit kaufen, zahlen Sie später zurück. KassenSturz zeigt, was Sie "
"darauf schulden."

#: crates/kassensturz-ui-bridge/qml/AccountsPage.qml:35
#, kde-format
msgctxt "@title"
msgid "Accounts"
msgstr "Konten"

#: crates/kassensturz-ui-bridge/qml/AccountsPage.qml:40
#: crates/kassensturz-ui-bridge/qml/AccountsPage.qml:69
#: crates/kassensturz-ui-bridge/qml/NewAccountPage.qml:152
#: crates/kassensturz-ui-bridge/qml/OverviewPage.qml:64
#, kde-format
msgctxt "@action:button"
msgid "Add account"
msgstr "Konto hinzufügen"

#: crates/kassensturz-ui-bridge/qml/AccountsPage.qml:46
#, kde-format
msgctxt ""
"@action:button get the accounts' new transactions from the bank over the "
"internet"
msgid "Get new transactions"
msgstr "Neue Buchungen abrufen"

#: crates/kassensturz-ui-bridge/qml/AccountsPage.qml:51
#, kde-format
msgctxt "@action:button"
msgid "Show closed accounts"
msgstr "Geschlossene Konten anzeigen"

#: crates/kassensturz-ui-bridge/qml/AccountsPage.qml:65
#: crates/kassensturz-ui-bridge/qml/BankFetchPage.qml:182
#, kde-format
msgctxt "@info"
msgid "You have no accounts yet"
msgstr "Sie haben noch keine Konten"

#: crates/kassensturz-ui-bridge/qml/AccountsPage.qml:66
#, kde-format
msgctxt "@info"
msgid ""
"An account is a place where your money is: your bank account, your wallet or "
"a credit card."
msgstr ""
"Ein Konto ist ein Ort, an dem Ihr Geld ist: Ihr Bankkonto, Ihr Portemonnaie "
"oder eine Kreditkarte."

#: crates/kassensturz-ui-bridge/qml/AccountsPage.qml:121
#, kde-format
msgctxt "@label %1 is an amount of money"
msgid "All together you owe %1"
msgstr "Zusammen schulden Sie %1"

#: crates/kassensturz-ui-bridge/qml/AccountsPage.qml:122
#, kde-format
msgctxt "@label %1 is an amount of money"
msgid "All together: %1"
msgstr "Zusammen: %1"

#: crates/kassensturz-ui-bridge/qml/AccountsPage.qml:131
#, kde-format
msgctxt "@title"
msgid "Closed accounts"
msgstr "Geschlossene Konten"

#: crates/kassensturz-ui-bridge/qml/Balance.qml:23
#, kde-format
msgctxt "@label %1 is an amount of money"
msgid "You owe %1"
msgstr "Sie schulden %1"

#: crates/kassensturz-ui-bridge/qml/BankAccountNames.qml:29
#, kde-format
msgctxt "@label an account at the bank, by its kind"
msgid "Checking account"
msgstr "Girokonto"

#: crates/kassensturz-ui-bridge/qml/BankAccountNames.qml:31
#, kde-format
msgctxt "@label an account at the bank, by its kind"
msgid "Savings account"
msgstr "Sparkonto"

#: crates/kassensturz-ui-bridge/qml/BankAccountNames.qml:33
#, kde-format
msgctxt "@label an account at the bank, by its kind"
msgid "Credit card"
msgstr "Kreditkarte"

#: crates/kassensturz-ui-bridge/qml/BankAccountNames.qml:35
#, kde-format
msgctxt "@label an account at the bank without a name"
msgid "Account"
msgstr "Konto"

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:52
#, kde-format
msgctxt "@title %1 is the name of an account"
msgid "Check %1 against my bank"
msgstr "%1 mit der Bank abgleichen"

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:77
#: crates/kassensturz-ui-bridge/qml/ImportPreviewPage.qml:74
#, kde-format
msgctxt "@label %1 is an amount of money"
msgid "you owe %1"
msgstr "Sie schulden %1"

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:83
#, kde-format
msgctxt "@label %1 is an amount of money"
msgid "%1 owed"
msgstr "%1 geschuldet"

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:92
#, kde-format
msgctxt "@info %2 is a date"
msgid ""
"%1 transaction is dated after %2. Your bank's figure for %2 doesn't have it "
"either, so it is left out on both sides."
msgid_plural ""
"%1 transactions are dated after %2. Your bank's figure for %2 doesn't have "
"them either, so they are left out on both sides."
msgstr[0] ""
"%1 Buchung ist auf einen Tag nach dem %2 datiert. Auch der Betrag Ihrer Bank "
"für den %2 enthält sie nicht, deshalb bleibt sie auf beiden Seiten außen vor."
msgstr[1] ""
"%1 Buchungen sind auf einen Tag nach dem %2 datiert. Auch der Betrag Ihrer "
"Bank für den %2 enthält sie nicht, deshalb bleiben sie auf beiden Seiten "
"außen vor."

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:94
#, kde-format
msgctxt "@info %1 is an amount of money, %2 is a date"
msgid ""
"The starting balance of %1 is dated %2, after the day you checked, so it "
"isn't counted. Check a later day."
msgstr ""
"Der Anfangsbestand von %1 ist auf den %2 datiert, also nach dem Tag, den Sie "
"abgleichen, und zählt deshalb nicht mit. Gleichen Sie einen späteren Tag ab."

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:97
#, kde-format
msgctxt "@info %1 is an amount of money, %2 is a date"
msgid ""
"The transaction of %1 on %2 is as large as the difference. Maybe it is in "
"your book twice, or your bank hasn't booked it yet."
msgstr ""
"Die Buchung über %1 vom %2 ist so groß wie der Unterschied. Vielleicht steht "
"sie doppelt in Ihrem Haushaltsbuch, oder Ihre Bank hat sie noch nicht "
"gebucht."

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:98
#, kde-format
msgctxt ""
"@info %1 is an amount of money, %2 is a date, %3 is who it was paid to or by"
msgid ""
"The transaction of %1 on %2 (%3) is as large as the difference. Maybe it is "
"in your book twice, or your bank hasn't booked it yet."
msgstr ""
"Die Buchung über %1 vom %2 (%3) ist so groß wie der Unterschied. Vielleicht "
"steht sie doppelt in Ihrem Haushaltsbuch, oder Ihre Bank hat sie noch nicht "
"gebucht."

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:101
#, kde-format
msgctxt "@info %1 is an amount of money, %2 is a date"
msgid ""
"If the transaction of %1 on %2 should be the other way round, money out "
"instead of in or the other way, both figures would agree."
msgstr ""
"Wäre die Buchung über %1 vom %2 andersherum, also Geld raus statt rein oder "
"umgekehrt, würden beide Beträge übereinstimmen."

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:102
#, kde-format
msgctxt ""
"@info %1 is an amount of money, %2 is a date, %3 is who it was paid to or by"
msgid ""
"If the transaction of %1 on %2 (%3) should be the other way round, money out "
"instead of in or the other way, both figures would agree."
msgstr ""
"Wäre die Buchung über %1 vom %2 (%3) andersherum, also Geld raus statt rein "
"oder umgekehrt, würden beide Beträge übereinstimmen."

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:105
#, kde-format
msgctxt "@info %1 is an amount of money"
msgid ""
"A transaction of %1 that added money to the account may be missing. Look for "
"it in your bank's statement."
msgstr ""
"Eine Buchung über %1, die Geld auf das Konto gebracht hat, fehlt vielleicht. "
"Suchen Sie sie im Kontoauszug Ihrer Bank."

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:106
#, kde-format
msgctxt "@info %1 is an amount of money"
msgid ""
"A transaction of %1 that took money out of the account may be missing, or "
"one of your transactions is too much. Look for it in your bank's statement."
msgstr ""
"Eine Buchung über %1, die Geld vom Konto genommen hat, fehlt vielleicht, "
"oder eine Ihrer Buchungen ist zu hoch. Suchen Sie im Kontoauszug Ihrer Bank."

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:108
#, kde-format
msgctxt "@info %1 and %2 are amounts of money"
msgid ""
"If the difference comes from before you started using KassenSturz, the "
"starting balance would have to be %1 instead of %2 for both to agree. "
"KassenSturz doesn't change it by itself."
msgstr ""
"Kommt der Unterschied aus der Zeit, bevor Sie KassenSturz benutzt haben, "
"müsste der Anfangsbestand %1 statt %2 sein, damit beide übereinstimmen. "
"KassenSturz ändert ihn nicht von selbst."

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:110
#, kde-format
msgctxt "@info %1 is an amount of money"
msgid ""
"This account has no starting balance. With a starting balance of %1, both "
"would agree."
msgstr ""
"Dieses Konto hat keinen Anfangsbestand. Mit einem Anfangsbestand von %1 "
"würden beide übereinstimmen."

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:112
#: crates/kassensturz-ui-bridge/qml/FormError.qml:361
#, kde-format
msgctxt "@info %1 is an error code"
msgid "Something went wrong (%1). Please report this, so it can be fixed."
msgstr ""
"Etwas ist schiefgegangen (%1). Bitte melden Sie das, damit es behoben werden "
"kann."

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:120
#, kde-format
msgctxt "@info %1 is an amount of money"
msgid "KassenSturz shows %1 less owed than your bank."
msgstr "KassenSturz zeigt %1 weniger Schulden als Ihre Bank."

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:121
#, kde-format
msgctxt "@info %1 is an amount of money"
msgid "KassenSturz shows %1 more owed than your bank."
msgstr "KassenSturz zeigt %1 mehr Schulden als Ihre Bank."

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:124
#, kde-format
msgctxt "@info %1 is an amount of money"
msgid "KassenSturz has %1 more than your bank."
msgstr "KassenSturz hat %1 mehr als Ihre Bank."

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:125
#, kde-format
msgctxt "@info %1 is an amount of money"
msgid "KassenSturz has %1 less than your bank."
msgstr "KassenSturz hat %1 weniger als Ihre Bank."

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:138
#, kde-format
msgctxt "@label:textbox"
msgid "What does your bank say you owe?"
msgstr "Wie viel schulden Sie laut Ihrer Bank?"

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:139
#, kde-format
msgctxt "@label:textbox"
msgid "What does your bank say is in it?"
msgstr "Wie viel ist laut Ihrer Bank darauf?"

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:140
#: crates/kassensturz-ui-bridge/qml/NewAccountPage.qml:112
#: crates/kassensturz-ui-bridge/qml/PartsPage.qml:160
#: crates/kassensturz-ui-bridge/qml/RuleCondition.qml:167
#: crates/kassensturz-ui-bridge/qml/RuleCondition.qml:176
#: crates/kassensturz-ui-bridge/qml/TransactionPage.qml:224
#, kde-format
msgctxt "@info:placeholder %1 is an example amount"
msgid "For example %1"
msgstr "Zum Beispiel %1"

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:148
#: crates/kassensturz-ui-bridge/qml/NewAccountPage.qml:119
#, kde-format
msgctxt "@label:textbox"
msgid "On which day?"
msgstr "An welchem Tag?"

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:149
#: crates/kassensturz-ui-bridge/qml/NewAccountPage.qml:120
#, kde-format
msgctxt "@info:placeholder %1 is today's date"
msgid "Today, %1"
msgstr "Heute, %1"

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:154
#, kde-format
msgctxt "@action:button"
msgid "Compare"
msgstr "Vergleichen"

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:167
#, kde-format
msgctxt "@info %1 is a date, %2 says how much money there is or what is owed"
msgid ""
"The starting balance is corrected. On %1 both your bank and KassenSturz now "
"say %2."
msgstr ""
"Der Anfangsbestand ist korrigiert. Am %1 sagen Ihre Bank und KassenSturz "
"jetzt beide: %2."

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:168
#, kde-format
msgctxt "@info %1 is a date, %2 says how much money there is or what is owed"
msgid "KassenSturz agrees with your bank. On %1 both say %2."
msgstr "KassenSturz stimmt mit Ihrer Bank überein. Am %1 sagen beide: %2."

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:181
#, kde-format
msgctxt ""
"@info %1 is a date, %2 and %3 say how much money there is or what is owed"
msgid "On %1 your bank says %2. KassenSturz says %3."
msgstr "Am %1 sagt Ihre Bank: %2. KassenSturz sagt: %3."

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:187
#, kde-format
msgctxt "@title"
msgid "Where the difference can come from"
msgstr "Woher der Unterschied kommen kann"

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:210
#, kde-format
msgctxt "@title"
msgid "Correct the starting balance"
msgstr "Anfangsbestand korrigieren"

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:221
#, kde-format
msgctxt "@info %1 is an amount of money, %2 and %3 are dates"
msgid ""
"If the difference comes from before you started using KassenSturz, a "
"starting balance of %1 dated %2 makes both agree. KassenSturz then has on %3 "
"what your bank says. Your other transactions stay as they are."
msgstr ""
"Kommt der Unterschied aus der Zeit, bevor Sie KassenSturz benutzt haben, "
"bringt ein Anfangsbestand von %1 mit dem Datum %2 beide in Einklang. "
"KassenSturz hat dann am %3, was Ihre Bank sagt. Ihre übrigen Buchungen "
"bleiben, wie sie sind."

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:222
#, kde-format
msgctxt "@info %1 is an amount of money, %2 and %3 are dates"
msgid ""
"If the difference comes from before you started using KassenSturz, a "
"starting balance of %1 (dated %2) makes both agree. KassenSturz then has on "
"%3 what your bank says. Your other transactions stay as they are."
msgstr ""
"Kommt der Unterschied aus der Zeit, bevor Sie KassenSturz benutzt haben, "
"bringt ein Anfangsbestand von %1 (datiert auf %2) beide in Einklang. "
"KassenSturz hat dann am %3, was Ihre Bank sagt. Ihre übrigen Buchungen "
"bleiben, wie sie sind."

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:231
#, kde-format
msgctxt "@action:button %1 is an amount of money"
msgid "Add a starting balance of %1"
msgstr "Anfangsbestand von %1 hinzufügen"

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:232
#, kde-format
msgctxt "@action:button %1 is an amount of money"
msgid "Set the starting balance to %1"
msgstr "Anfangsbestand auf %1 setzen"

#: crates/kassensturz-ui-bridge/qml/BankDialogs.qml:38
#, kde-format
msgctxt "@info the made-up bank asks for a TAN"
msgid "Type the TAN your TAN app shows for this login."
msgstr "Geben Sie die TAN ein, die Ihre TAN-App für diese Anmeldung anzeigt."

#: crates/kassensturz-ui-bridge/qml/BankDialogs.qml:40
#, kde-format
msgctxt "@title the made-up bank waits for an approval"
msgid "Waiting for approval"
msgstr "Warten auf Freigabe"

#: crates/kassensturz-ui-bridge/qml/BankDialogs.qml:42
#, kde-format
msgctxt "@info the made-up bank waits for an approval"
msgid "Approve this login in your banking app, then choose Approved."
msgstr "Geben Sie diese Anmeldung in Ihrer Banking-App frei und wählen Sie dann „Freigegeben“."

#: crates/kassensturz-ui-bridge/qml/BankDialogs.qml:44
#, kde-format
msgctxt "@action:button the made-up bank's approval was given"
msgid "Approved"
msgstr "Freigegeben"

#: crates/kassensturz-ui-bridge/qml/BankDialogs.qml:46
#, kde-format
msgctxt "@action:button stop the login"
msgid "Abort"
msgstr "Abbrechen"

#: crates/kassensturz-ui-bridge/qml/BankDialogs.qml:96
#, kde-format
msgctxt "@title:window"
msgid "Your bank asks for a TAN"
msgstr "Ihre Bank fragt nach einer TAN"

#: crates/kassensturz-ui-bridge/qml/BankDialogs.qml:103
#, kde-format
msgctxt "@action:button send the TAN to the bank"
msgid "Send TAN"
msgstr "TAN senden"

#: crates/kassensturz-ui-bridge/qml/BankDialogs.qml:109
#: crates/kassensturz-ui-bridge/qml/BankDialogs.qml:188
#: crates/kassensturz-ui-bridge/qml/BankFetchPage.qml:381
#, kde-format
msgctxt "@action:button"
msgid "Cancel"
msgstr "Abbrechen"

#: crates/kassensturz-ui-bridge/qml/BankDialogs.qml:127
#, kde-format
msgctxt "@info"
msgid ""
"Your bank wants you to confirm this with a TAN. The bank's message below "
"says what it is for and where the TAN comes from, for example your TAN app "
"or a text message:"
msgstr ""
"Ihre Bank möchte, dass Sie dies mit einer TAN bestätigen. Die Nachricht der "
"Bank unten sagt, wofür die TAN ist und woher sie kommt, zum Beispiel aus "
"Ihrer TAN-App oder per SMS:"

#: crates/kassensturz-ui-bridge/qml/BankDialogs.qml:137
#, kde-format
msgctxt "@info:whatsthis"
msgid "Your bank's message"
msgstr "Die Nachricht Ihrer Bank"

#: crates/kassensturz-ui-bridge/qml/BankDialogs.qml:144
#, kde-format
msgctxt "@info:placeholder"
msgid "TAN"
msgstr "TAN"

#: crates/kassensturz-ui-bridge/qml/BankDialogs.qml:145
#, kde-format
msgctxt "@label:textbox"
msgid "TAN"
msgstr "TAN"

#: crates/kassensturz-ui-bridge/qml/BankDialogs.qml:154
#, kde-format
msgctxt "@info"
msgid ""
"KassenSturz sends the TAN to your bank once and doesn't keep it. It only "
"reads from your bank; it never sends money."
msgstr ""
"KassenSturz sendet die TAN einmal an Ihre Bank und behält sie nicht. Es "
"liest nur von Ihrer Bank; es überweist nie Geld."

#: crates/kassensturz-ui-bridge/qml/BankDialogs.qml:175
#, kde-format
msgctxt "@title:window"
msgid "Your bank asks for your PIN"
msgstr "Ihre Bank fragt nach Ihrer PIN"

#: crates/kassensturz-ui-bridge/qml/BankDialogs.qml:182
#, kde-format
msgctxt "@action:button send the PIN to the bank"
msgid "Send PIN"
msgstr "PIN senden"

#: crates/kassensturz-ui-bridge/qml/BankDialogs.qml:208
#, kde-format
msgctxt "@info"
msgid ""
"Your bank said the PIN you typed was wrong. KassenSturz has forgotten it. "
"Check it before you try again: after a few wrong PINs a bank blocks the "
"login."
msgstr ""
"Ihre Bank sagt, die eingegebene PIN war falsch. KassenSturz hat sie "
"vergessen. Prüfen Sie sie, bevor Sie es noch einmal versuchen: Nach einigen "
"falschen PINs sperrt eine Bank den Zugang."

#: crates/kassensturz-ui-bridge/qml/BankDialogs.qml:217
#, kde-format
msgctxt "@info %1 is the name of a bank"
msgid "Type the PIN you use for %1."
msgstr "Geben Sie die PIN ein, die Sie für %1 verwenden."

#: crates/kassensturz-ui-bridge/qml/BankDialogs.qml:224
#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:249
#, kde-format
msgctxt "@info:placeholder"
msgid "PIN"
msgstr "PIN"

#: crates/kassensturz-ui-bridge/qml/BankDialogs.qml:225
#, kde-format
msgctxt "@label:textbox"
msgid "PIN"
msgstr "PIN"

#: crates/kassensturz-ui-bridge/qml/BankDialogs.qml:233
#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:255
#, kde-format
msgctxt "@label:listbox"
msgid "Remember the PIN:"
msgstr "PIN merken:"

#: crates/kassensturz-ui-bridge/qml/BankDialogs.qml:237
#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:259
#, kde-format
msgctxt "@item:inlistbox keep the PIN"
msgid "No, ask me each time"
msgstr "Nein, jedes Mal fragen"

#: crates/kassensturz-ui-bridge/qml/BankDialogs.qml:238
#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:260
#, kde-format
msgctxt "@item:inlistbox keep the PIN"
msgid "Until I close KassenSturz"
msgstr "Bis ich KassenSturz schließe"

#: crates/kassensturz-ui-bridge/qml/BankDialogs.qml:239
#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:261
#, kde-format
msgctxt "@item:inlistbox keep the PIN"
msgid "Save it in my keychain"
msgstr "Im Passwortspeicher speichern"

#: crates/kassensturz-ui-bridge/qml/BankDialogs.qml:247
#, kde-format
msgctxt "@info"
msgid ""
"KassenSturz sends the PIN to your bank and keeps it only as long as you "
"choose. It only reads from your bank; it never sends money."
msgstr ""
"KassenSturz sendet die PIN an Ihre Bank und behält sie nur so lange, wie Sie "
"es wählen. Es liest nur von Ihrer Bank und überweist nie Geld."

#: crates/kassensturz-ui-bridge/qml/BankDialogs.qml:264
#, kde-format
msgctxt "@title:window"
msgid "Your bank asks"
msgstr "Ihre Bank fragt"

#: crates/kassensturz-ui-bridge/qml/BankFetchPage.qml:60
#, kde-format
msgctxt "@title"
msgid "Get new transactions"
msgstr "Neue Buchungen abrufen"

#: crates/kassensturz-ui-bridge/qml/BankFetchPage.qml:69
#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:56
#, kde-format
msgctxt "@info"
msgid ""
"Trying it out: a made-up bank stands in for yours. Its PIN is 12345 and its "
"TAN 123456; nothing reaches a real bank."
msgstr ""
"Zum Ausprobieren: Eine erfundene Bank steht für Ihre. PIN: 12345, TAN: "
"123456; nichts erreicht eine echte Bank."

#: crates/kassensturz-ui-bridge/qml/BankFetchPage.qml:176
#, kde-format
msgctxt "@info"
msgid ""
"KassenSturz asks your bank for the transactions since the last time and "
"shows them to you first. Nothing is added to your book until you say so. It "
"only reads from your bank; it never sends money."
msgstr ""
"KassenSturz fragt Ihre Bank nach den Buchungen seit dem letzten Mal und "
"zeigt sie Ihnen zuerst. Nichts kommt in Ihr Haushaltsbuch, bevor Sie "
"zustimmen. Es liest nur von Ihrer Bank und überweist nie Geld."

#: crates/kassensturz-ui-bridge/qml/BankFetchPage.qml:183
#, kde-format
msgctxt "@info"
msgid "Add an account first, then link it to your bank account here."
msgstr ""
"Legen Sie zuerst ein Konto an und verknüpfen Sie es dann hier mit Ihrem "
"Bankkonto."

#: crates/kassensturz-ui-bridge/qml/BankFetchPage.qml:240
#, kde-format
msgctxt "@info"
msgid "Not linked to a bank account yet"
msgstr "Noch nicht mit einem Bankkonto verknüpft"

#: crates/kassensturz-ui-bridge/qml/BankFetchPage.qml:243
#, kde-format
msgctxt "@info %1 is a bank account number"
msgid "Linked to %1 · not fetched yet"
msgstr "Verknüpft mit %1 · noch nichts abgerufen"

#: crates/kassensturz-ui-bridge/qml/BankFetchPage.qml:244
#, kde-format
msgctxt "@info %1 is a bank account number, %2 a date"
msgid "Linked to %1 · last fetched on %2"
msgstr "Verknüpft mit %1 · zuletzt abgerufen am %2"

#: crates/kassensturz-ui-bridge/qml/BankFetchPage.qml:257
#, kde-format
msgctxt "@action:button"
msgid "Link to a bank account…"
msgstr "Mit einem Bankkonto verknüpfen…"

#: crates/kassensturz-ui-bridge/qml/BankFetchPage.qml:273
#, kde-format
msgctxt "@info"
msgid "Not fetched, because the one before failed. Try again."
msgstr ""
"Nicht abgerufen, weil der Abruf davor fehlgeschlagen ist. Versuchen Sie es "
"noch einmal."

#: crates/kassensturz-ui-bridge/qml/BankFetchPage.qml:284
#, kde-format
msgctxt "@action:button"
msgid "Look at %1 transaction from your bank"
msgid_plural "Look at %1 transactions from your bank"
msgstr[0] "%1 Buchung von Ihrer Bank ansehen"
msgstr[1] "%1 Buchungen von Ihrer Bank ansehen"

#: crates/kassensturz-ui-bridge/qml/BankFetchPage.qml:285
#, kde-format
msgctxt "@action:button"
msgid "Look at what your bank sent"
msgstr "Ansehen, was Ihre Bank geschickt hat"

#: crates/kassensturz-ui-bridge/qml/BankFetchPage.qml:294
#, kde-format
msgctxt "@info"
msgid "You looked at it. Get the transactions again to see them once more."
msgstr ""
"Sie haben es angesehen. Rufen Sie die Buchungen noch einmal ab, um sie "
"wieder zu sehen."

#: crates/kassensturz-ui-bridge/qml/BankFetchPage.qml:295
#, kde-format
msgctxt "@info"
msgid "Nothing is added to your book before you say so."
msgstr "Nichts kommt in Ihr Haushaltsbuch, bevor Sie zustimmen."

#: crates/kassensturz-ui-bridge/qml/BankFetchPage.qml:313
#, kde-format
msgctxt "@action:button"
msgid "Get new transactions"
msgstr "Neue Buchungen abrufen"

#: crates/kassensturz-ui-bridge/qml/BankFetchPage.qml:325
#, kde-format
msgctxt "@info %1 is the name of an account"
msgid ""
"Getting the new transactions for %1 from your bank… Your bank may ask for a "
"TAN, or for your approval in its app."
msgstr ""
"Neue Buchungen für %1 werden bei Ihrer Bank abgerufen… Ihre Bank verlangt "
"vielleicht eine TAN oder Ihre Freigabe in ihrer App."

#: crates/kassensturz-ui-bridge/qml/BankFetchPage.qml:326
#, kde-format
msgctxt "@info"
msgid "Talking to your bank…"
msgstr "Verbindung zu Ihrer Bank wird hergestellt…"

#: crates/kassensturz-ui-bridge/qml/BankFetchPage.qml:332
#: crates/kassensturz-ui-bridge/qml/BankFetchPage.qml:411
#: crates/kassensturz-ui-bridge/qml/SettingsPage.qml:241
#, kde-format
msgctxt "@action:button"
msgid "Connect a bank…"
msgstr "Eine Bank verbinden…"

#: crates/kassensturz-ui-bridge/qml/BankFetchPage.qml:369
#, kde-format
msgctxt "@title:window"
msgid "Link to a bank account"
msgstr "Mit einem Bankkonto verknüpfen"

#: crates/kassensturz-ui-bridge/qml/BankFetchPage.qml:375
#, kde-format
msgctxt "@action:button"
msgid "Link"
msgstr "Verknüpfen"

#: crates/kassensturz-ui-bridge/qml/BankFetchPage.qml:399
#, kde-format
msgctxt "@info %1 is the name of an account"
msgid "Which bank account fills %1? Its new transactions are fetched into it."
msgstr ""
"Aus welchem Bankkonto sollen die neuen Buchungen für %1 abgerufen werden?"

#: crates/kassensturz-ui-bridge/qml/BankFetchPage.qml:406
#, kde-format
msgctxt "@info"
msgid ""
"Your bank logins list no bank account that isn't linked yet. Connect your "
"bank first, or check that the bank account isn't linked to another account "
"already."
msgstr ""
"Ihre Bankzugänge nennen kein Bankkonto, das noch nicht verknüpft ist. "
"Verbinden Sie zuerst Ihre Bank oder prüfen Sie, ob das Bankkonto schon mit "
"einem anderen Konto verknüpft ist."

#: crates/kassensturz-ui-bridge/qml/BankFetchPage.qml:461
#, kde-format
msgctxt "@info %1 is an IBAN or account number, %2 the name of a bank"
msgid "%1 · %2"
msgstr "%1 · %2"

#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:47
#, kde-format
msgctxt "@title"
msgid "Connect a bank"
msgstr "Eine Bank verbinden"

#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:139
#, kde-format
msgctxt "@info"
msgid ""
"KassenSturz can fetch your transactions from your bank, so you don't have to "
"type them. It only reads; it never sends money. Start with the IBAN of one "
"of your accounts at the bank: you find it on your bank card or in your "
"bank's app."
msgstr ""
"KassenSturz kann Ihre Buchungen von Ihrer Bank abrufen, damit Sie sie nicht "
"abtippen müssen. Es liest nur; es überweist nie Geld. Beginnen Sie mit der "
"IBAN eines Ihrer Konten bei der Bank: Sie finden sie auf Ihrer Bankkarte "
"oder in der App Ihrer Bank."

#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:144
#, kde-format
msgctxt "@label:textbox"
msgid "IBAN:"
msgstr "IBAN:"

#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:145
#, kde-format
msgctxt "@info:placeholder an example IBAN"
msgid "For example DE89 3704 0044 0532 0130 00"
msgstr "Zum Beispiel DE89 3704 0044 0532 0130 00"

#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:156
#, kde-format
msgctxt "@info"
msgid ""
"Banks outside Germany can't be connected yet: the system KassenSturz uses "
"for this (FinTS) is a German one. Import the files your bank offers instead."
msgstr ""
"Banken außerhalb Deutschlands lassen sich noch nicht verbinden: Das "
"Verfahren, das KassenSturz dafür nutzt (FinTS), ist ein deutsches. "
"Importieren Sie stattdessen die Dateien, die Ihre Bank anbietet."

#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:157
#, kde-format
msgctxt "@info"
msgid ""
"This bank offers logins with a chip card only, which KassenSturz can't set "
"up yet. Import the files your bank offers instead."
msgstr ""
"Diese Bank bietet nur Zugänge mit Chipkarte an, die KassenSturz noch nicht "
"einrichten kann. Importieren Sie stattdessen die Dateien, die Ihre Bank "
"anbietet."

#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:161
#, kde-format
msgctxt "@action:button"
msgid "Find my bank"
msgstr "Meine Bank finden"

#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:175
#, kde-format
msgctxt "@label"
msgid "Bank:"
msgstr "Bank:"

#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:182
#, kde-format
msgctxt "@info %1 is a bank code"
msgid "Bank code %1"
msgstr "Bankleitzahl %1"

#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:186
#, kde-format
msgctxt "@label"
msgid "Account:"
msgstr "Konto:"

#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:198
#, kde-format
msgctxt "@info"
msgid ""
"KassenSturz's bank lists don't know this bank yet. If your bank offers FinTS "
"(some call it HBCI), type the address it gives for it below; your bank's "
"website or support can tell you."
msgstr ""
"Die Bankenlisten von KassenSturz kennen diese Bank noch nicht. Wenn Ihre "
"Bank FinTS anbietet (manche sagen HBCI), geben Sie unten die Adresse ein, "
"die sie dafür nennt; die Website oder der Kundendienst Ihrer Bank kann sie "
"Ihnen sagen."

#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:200
#, kde-format
msgctxt "@info"
msgid ""
"KassenSturz's bank lists don't have this bank's FinTS address. If your bank "
"offers FinTS (some call it HBCI), type the address it gives for it below; "
"your bank's website or support can tell you."
msgstr ""
"Den Bankenlisten von KassenSturz fehlt die FinTS-Adresse dieser Bank. Wenn "
"Ihre Bank FinTS anbietet (manche sagen HBCI), geben Sie unten die Adresse "
"ein, die sie dafür nennt; die Website oder der Kundendienst Ihrer Bank kann "
"sie Ihnen sagen."

#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:202
#, kde-format
msgctxt "@info"
msgid ""
"KassenSturz's bank lists don't have this bank's FinTS address. Banks of your "
"bank's kind nearby use the address below, so it is probably yours, but this "
"is a guess. If connecting fails, check the address on your bank's website or "
"ask its support, and type the right one."
msgstr ""
"Den Bankenlisten von KassenSturz fehlt die FinTS-Adresse dieser Bank. Banken "
"derselben Art in der Nähe Ihrer Bank nutzen die Adresse unten, es ist also "
"wahrscheinlich Ihre – aber das ist nur eine Vermutung. Wenn die Verbindung "
"nicht klappt, prüfen Sie die Adresse auf der Website Ihrer Bank oder fragen "
"Sie deren Kundendienst, und geben Sie die richtige ein."

#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:204
#, kde-format
msgctxt "@info"
msgid ""
"KassenSturz's bank lists don't say how you log in at this bank. KassenSturz "
"tries a login with a PIN and a TAN, which most banks use."
msgstr ""
"Die Bankenlisten von KassenSturz sagen nicht, wie Sie sich bei dieser Bank "
"anmelden. KassenSturz versucht eine Anmeldung mit PIN und TAN, wie sie die "
"meisten Banken nutzen."

#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:213
#, kde-format
msgctxt "@label:textbox the bank's FinTS server address"
msgid "FinTS address:"
msgstr "FinTS-Adresse:"

#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:221
#, kde-format
msgctxt "@label:textbox"
msgid "Login name:"
msgstr "Anmeldename:"

#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:230
#, kde-format
msgctxt "@info"
msgid ""
"The name or number you log in to your bank's website with. Banks call it "
"differently, for example login name, user ID or customer number."
msgstr ""
"Der Name oder die Nummer, mit der Sie sich auf der Website Ihrer Bank "
"anmelden. Banken nennen das unterschiedlich, zum Beispiel Anmeldename, "
"Benutzerkennung oder Kundennummer."

#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:236
#, kde-format
msgctxt "@label:textbox"
msgid "Customer ID:"
msgstr "Kunden-ID:"

#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:237
#, kde-format
msgctxt "@label:textbox"
msgid "Customer ID (if any):"
msgstr "Kunden-ID (falls vorhanden):"

#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:241
#, kde-format
msgctxt "@info:placeholder"
msgid "Only if your bank gave you one"
msgstr "Nur wenn Ihre Bank Ihnen eine gegeben hat"

#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:248
#, kde-format
msgctxt "@label:textbox"
msgid "PIN:"
msgstr "PIN:"

#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:273
#, kde-format
msgctxt "@info"
msgid ""
"KassenSturz keeps the PIN in memory only, never in a file, and forgets it "
"when you close it."
msgstr ""
"KassenSturz behält die PIN nur im Arbeitsspeicher, nie in einer Datei, und "
"vergisst sie, wenn Sie es schließen."

#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:275
#, kde-format
msgctxt "@info"
msgid ""
"KassenSturz saves the PIN in your system's keychain (for example KWallet), "
"not in your book. You can remove it in Settings at any time."
msgstr ""
"KassenSturz speichert die PIN im Passwortspeicher Ihres Systems (zum "
"Beispiel KWallet), nicht in Ihrem Haushaltsbuch. Sie können sie jederzeit in "
"den Einstellungen entfernen."

#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:277
#, kde-format
msgctxt "@info"
msgid ""
"KassenSturz forgets the PIN as soon as it has talked to your bank. This is "
"the safest choice."
msgstr ""
"KassenSturz vergisst die PIN, sobald es mit Ihrer Bank gesprochen hat. Das "
"ist die sicherste Wahl."

#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:283
#, kde-format
msgctxt "@action:button"
msgid "Connect"
msgstr "Verbinden"

#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:303
#, kde-format
msgctxt "@info"
msgid ""
"Talking to your bank… This can take a minute. Your bank may ask for a TAN, "
"or for your approval in its app."
msgstr ""
"Verbindung zu Ihrer Bank wird hergestellt… Das kann eine Minute dauern. Ihre "
"Bank fragt vielleicht nach einer TAN oder nach Ihrer Freigabe in ihrer App."

#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:318
#, kde-format
msgctxt "@info"
msgid ""
"Connected. Your bank shows these accounts. Choose which account in "
"KassenSturz each one fills, so its transactions can be fetched into it."
msgstr ""
"Verbunden. Ihre Bank zeigt diese Konten. Wählen Sie für jedes, in welches "
"Konto in KassenSturz seine Buchungen abgerufen werden sollen."

#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:346
#, kde-format
msgctxt "@label %1 is the bank's name of an account, %2 its IBAN or number"
msgid "%1, %2"
msgstr "%1, %2"

#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:354
#, kde-format
msgctxt "@label:listbox"
msgid "Account in KassenSturz"
msgstr "Konto in KassenSturz"

#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:357
#, kde-format
msgctxt "@item:inlistbox"
msgid "Don't fill an account from it"
msgstr "Kein Konto daraus füllen"

#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:369
#, kde-format
msgctxt "@info"
msgid ""
"Your book has no account yet that the bank could fill. Add your accounts "
"first; you can link them to the bank's accounts when you get new "
"transactions."
msgstr ""
"Ihr Haushaltsbuch hat noch kein Konto, das die Bank füllen könnte. Legen Sie "
"zuerst Ihre Konten an; Sie können sie beim Abrufen neuer Buchungen mit den "
"Konten der Bank verknüpfen."

#: crates/kassensturz-ui-bridge/qml/BankSetupPage.qml:373
#: crates/kassensturz-ui-bridge/qml/ImportDonePage.qml:42
#, kde-format
msgctxt "@action:button"
msgid "Done"
msgstr "Fertig"

#: crates/kassensturz-ui-bridge/qml/BookFromFileDonePage.qml:36
#, kde-format
msgctxt "@item what was left out, %1 is how many"
msgid "%1 investment account"
msgid_plural "%1 investment accounts"
msgstr[0] "%1 Depot"
msgstr[1] "%1 Depots"

#: crates/kassensturz-ui-bridge/qml/BookFromFileDonePage.qml:38
#, kde-format
msgctxt "@item what was left out, %1 is how many"
msgid "%1 scheduled or recurring transaction"
msgid_plural "%1 scheduled or recurring transactions"
msgstr[0] "%1 geplante oder wiederkehrende Buchung"
msgstr[1] "%1 geplante oder wiederkehrende Buchungen"

#: crates/kassensturz-ui-bridge/qml/BookFromFileDonePage.qml:40
#, kde-format
msgctxt "@item what was left out, %1 is how many"
msgid "%1 budget"
msgid_plural "%1 budgets"
msgstr[0] "%1 Budget"
msgstr[1] "%1 Budgets"

#: crates/kassensturz-ui-bridge/qml/BookFromFileDonePage.qml:42
#, kde-format
msgctxt "@item what was left out, %1 is how many"
msgid "%1 saved report"
msgid_plural "%1 saved reports"
msgstr[0] "%1 gespeicherter Bericht"
msgstr[1] "%1 gespeicherte Berichte"

#: crates/kassensturz-ui-bridge/qml/BookFromFileDonePage.qml:44
#, kde-format
msgctxt "@item what was left out, %1 is how many"
msgid "%1 tag that no transaction could be given"
msgid_plural "%1 tags that no transaction could be given"
msgstr[0] "%1 Schlagwort, das keiner Buchung zugeordnet werden konnte"
msgstr[1] "%1 Schlagwörter, die keiner Buchung zugeordnet werden konnten"

#: crates/kassensturz-ui-bridge/qml/BookFromFileDonePage.qml:46
#, kde-format
msgctxt "@item what was left out, %1 is how many"
msgid "%1 exchange rate or price that can't be kept exactly"
msgid_plural "%1 exchange rates or prices that can't be kept exactly"
msgstr[0] "%1 Wechselkurs oder Preis, der sich nicht exakt übernehmen lässt"
msgstr[1] "%1 Wechselkurse oder Preise, die sich nicht exakt übernehmen lassen"

#: crates/kassensturz-ui-bridge/qml/BookFromFileDonePage.qml:48
#, kde-format
