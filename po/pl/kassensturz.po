#, kde-format
msgctxt "@info %1 is an error code"
msgid "Something went wrong (%1). Please report this, so it can be fixed."
msgstr "Coś poszło nie tak (%1). Zgłoś to, aby można było to naprawić."

#: crates/kassensturz-ui-bridge/qml/BankCheckPage.qml:120
