msgstr "Utwórz księgę"

#: crates/kassensturz-ui-bridge/qml/BookFromFilePage.qml:222
#, kde-format
msgctxt "@action:button"
msgid "Don't make a book"
msgstr "Nie twórz księgi"

#: crates/kassensturz-ui-bridge/qml/BookFromFilePage.qml:223
#, kde-format
msgctxt "@info"
msgid "The file stays as it is."
msgstr "Plik pozostaje bez zmian."

#: crates/kassensturz-ui-bridge/qml/BookProblemPage.qml:40
#, kde-format
