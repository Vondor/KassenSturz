msgstr "Ten rodzaj znacznika nie jest tu obsługiwany."

#: crates/kassensturz-ui-bridge/qml/SpecPage.qml:55
#, kde-format
msgctxt "@info a part of a chart description that is not supported"
msgid ""
"Putting several charts together in one description isn't supported here."
msgstr "Łączenie kilku wykresów w jednym opisie nie jest tu obsługiwane."

#: crates/kassensturz-ui-bridge/qml/SpecPage.qml:57
#, kde-format
msgctxt "@info a part of a chart description that is not supported"
msgid "This way of showing data isn't supported here, or not for this mark."
msgstr "Ten sposób pokazywania danych nie jest tu obsługiwany albo nie dla tego znacznika."

#: crates/kassensturz-ui-bridge/qml/SpecPage.qml:59
#, kde-format
msgctxt "@info a part of a chart description that is not supported"
msgid "Bars that run sideways aren't supported here."
msgstr "Słupki biegnące poziomo nie są tu obsługiwane."

#: crates/kassensturz-ui-bridge/qml/SpecPage.qml:61
#, kde-format
msgctxt "@info a part of a chart description that is not supported"
msgid "This option isn't supported here."
msgstr "Ta opcja nie jest tu obsługiwana."

#: crates/kassensturz-ui-bridge/qml/SpecPage.qml:63
#, kde-format
msgctxt "@info a part of a chart description that is not supported"
