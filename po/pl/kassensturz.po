msgstr "Na przykład: Fast food"

#: crates/kassensturz-ui-bridge/qml/ColumnBoard.qml:1165
#, kde-format
msgctxt "@label:textbox"
msgid "Name of the new column"
msgstr "Nazwa nowej kolumny"

