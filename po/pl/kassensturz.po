msgctxt "@action:button"
msgid "Cancel"
msgstr "Nie"

msgctxt "@label a field of a transaction"
msgid "Amount"
msgstr "Kwota"

msgctxt "@label a field of a transaction"
msgid "Date"
msgstr "Data"

msgctxt "@action:button take the last change back"
msgid "Undo"
msgstr "Tak"

msgctxt "@info:placeholder"
msgid "The provider's key for this question"
msgstr "Tekst"

msgctxt "@title:column what the AI may do"
msgid "Delete"
msgstr "Usuwanie"

msgctxt "@info what is sent"
msgid "Your key for this provider, if it needs one, so that it accepts the request."
msgstr "Informacja"

msgctxt "@info"
msgid "Unencrypted connections are now off. Nothing is sent to the saved http:// address any more."
msgstr "Tekst"

msgctxt "@action:button"
msgid "Save"
msgstr "Zapisz"

msgctxt "@action:button"
msgid "Remove the key from this computer"
msgstr "Tekst"

msgctxt "@item:inlistbox what to do when the AI takes long"
msgid "Keep waiting and warn me, so I can cancel"
msgstr "Tekst"

msgctxt "@title:window"
msgid "What KassenSturz sends to this provider"
msgstr "Informacja"

msgctxt "@title"
msgid "Correct the starting balance"
msgstr "Informacja"

msgctxt "@title:window"
msgid "Your bank asks for your PIN"
msgstr "OK"

msgctxt "@info %1 is a list of names"
msgid "These got a number after their name, so you can tell them apart: %1"
msgstr "Numer: %1"

msgctxt "@info"
msgid "No Rule was made for this name. You can make one under Rules."
msgstr "Tekst"

msgctxt "@option:check"
msgid "Make Rules only for names with a matching text"
msgstr "Informacja"

msgctxt "@info a change you made"
msgid "Matched an entry to a planned payment"
msgstr "OK"

msgctxt "@item:inlistbox"
msgid "Day, month, year (31.12.2026)"
msgstr "OK"

msgctxt "@info"
msgid "The target is zero, so there is nothing to measure the bar against. Change the target."
msgstr "OK"

msgctxt "@info %1 is the name of an account, %2 an amount of money"
msgid "%1 still has %2 in it. Move the money to another account first, then close it."
msgstr "%1 %2"

msgctxt "@info"
msgid "This amount is larger than KassenSturz can add up over the periods of a budget. Enter a smaller amount."
msgstr "Tekst"

msgctxt "@info"
msgid "The bank's question was closed before it was answered, so nothing was done. Start again when you are ready."
msgstr "OK"

msgctxt "@action:inmenu a screen"
msgid "Settings"
msgstr "Rzeczy"

msgctxt "@item:inlistbox a range across zero, typed with minus signs for money paid"
msgid "paid or received (use minus signs)"
msgstr "Informacja"

msgctxt "@info"
msgid "This transaction is broken down into several parts, which have their own page."
msgstr "OK"

msgctxt "@item:inlistbox"
msgid "2.2 (only if your bank says so)"
msgstr "Tekst"

msgctxt "@info"
msgid "That address points to a computer in your own network, not to a bank. Check it against what your bank gives."
msgstr "OK"

msgctxt "@info"
msgid "A budget only shows how your spending compares; it changes no booking. Undo takes it back."
msgstr "Tekst"

msgctxt "@info"
msgid "Count Pets only when it is above 100"
msgstr "OK"

msgctxt "@info a function of formulas, its English name first"
msgid "MIN: the smallest of the figures."
msgstr "OK"

msgctxt "@item:inlistbox no colour for: %1 is a whole number of percent"
msgid "Changes smaller than %1 %"
msgstr "Zmiany %1 %"

msgctxt "@info"
msgid "The line could not be added to your notes."
msgstr "Tekst"

msgctxt "@info"
msgid "No more payments: it has ended."
msgstr "Informacja"

msgctxt "@info"
msgid "See them and take the access back."
msgstr "Informacja"
