msgstr[1] "%1 z %2 okresów, z których to porównanie liczy średnią, są sprzed pierwszej transakcji i liczą się jako zero."
msgstr[2] "%1 z %2 okresów, z których to porównanie liczy średnią, jest sprzed pierwszej transakcji i liczy się jako zero."

#: crates/kassensturz-ui-bridge/qml/BudgetBars.qml
#, kde-format
msgctxt "@info"
msgid "From this period on, the budget counts other categories or accounts."
msgstr "Od tego okresu budżet liczy inne kategorie lub konta."

#: crates/kassensturz-ui-bridge/qml/BudgetPage.qml
#, kde-format
msgctxt "@info %1 is a date, %2 a list of categories"
msgid "Until %1 it counted %2."
msgstr "Do %1 liczył %2."

#: crates/kassensturz-ui-bridge/qml/BudgetPage.qml
#, kde-format
msgctxt "@info %1 is a date, %2 a list of categories, %3 a list of account names"
msgid "Until %1 it counted %2, only money paid from %3."
msgstr "Do %1 liczył %2, tylko pieniądze zapłacone z %3."

#: crates/kassensturz-ui-bridge/qml/BudgetPage.qml
#, kde-format
msgctxt "@info %1 is a date, %2 a list of categories"
msgid "From %1 on it counts %2."
msgstr "Od %1 liczy %2."

#: crates/kassensturz-ui-bridge/qml/BudgetPage.qml
#, kde-format
msgctxt "@info %1 is a date, %2 a list of categories, %3 a list of account names"
msgid "From %1 on it counts %2, only money paid from %3."
msgstr "Od %1 liczy %2, tylko pieniądze zapłacone z %3."

#: crates/kassensturz-ui-bridge/qml/BudgetPage.qml
#, kde-format
msgctxt "@option:check"
msgid "Change the categories or accounts"
msgstr "Zmień kategorie lub konta"

#: crates/kassensturz-ui-bridge/qml/BudgetPage.qml
#, kde-format
msgctxt "@info"
msgid ""
"Earlier periods keep counting what they counted, so their results don't "
"change."
msgstr "Wcześniejsze okresy nadal liczą to, co liczyły, więc ich wyniki się nie zmieniają."

#: crates/kassensturz-ui-bridge/qml/FormError.qml
#, kde-format
msgctxt "@info"
msgid ""
"What a budget counts changes from this period on, so the results of earlier "
"periods stay. Choose this period or a later one."
msgstr "To, co liczy budżet, zmienia się od tego okresu, więc wyniki wcześniejszych okresów zostają. Wybierz ten okres albo późniejszy."

#: crates/kassensturz-ui-bridge/qml/FormError.qml
#, kde-format
msgctxt "@info %1 is a number"
msgid ""
"A budget can keep at most %1 changes of what it counts. Stop it and set a new "
"budget instead."
msgstr "Budżet może zachować najwyżej %1 zmian tego, co liczy. Zakończ go i zamiast tego ustaw nowy budżet."

#: crates/kassensturz-ui-bridge/qml/ColumnBoard.qml
#, kde-format
msgctxt "@info an example of a formula; the words in quotes stay in English"
msgid "A column can also be a formula, e.g. =Salary@\"last month\", with its own period."
msgstr "Kolumna może też być formułą, np. =Wynagrodzenie@\"last month\", z własnym okresem."

#: crates/kassensturz-ui-bridge/qml/AiBudgetChange.qml
#, kde-format
msgctxt "@info %1 is a list of categories"
msgid "Now it counts %1."
msgstr "Teraz liczy %1."

#: crates/kassensturz-ui-bridge/qml/AiBudgetChange.qml
#, kde-format
msgctxt "@info %1 is a list of categories, %2 a list of account names"
msgid "Now it counts %1, only money paid from %2."
msgstr "Teraz liczy %1, tylko pieniądze zapłacone z %2."

#: crates/kassensturz-ui-bridge/qml/AiBudgetChange.qml
#, kde-format
msgctxt "@info %1 is a list of categories"
msgid "From this change on it counts %1."
msgstr "Od tej zmiany liczy %1."

#: crates/kassensturz-ui-bridge/qml/AiBudgetChange.qml
#, kde-format
msgctxt "@info %1 is a list of categories, %2 a list of account names"
msgid "From this change on it counts %1, only money paid from %2."
msgstr "Od tej zmiany liczy %1, tylko pieniądze zapłacone z %2."

#: crates/kassensturz-ui-bridge/qml/AiBudgetChange.qml
#, kde-format
msgctxt "@info"
msgid ""
"Earlier periods keep counting what they counted, so their results don't "
"change. Every amount stays as it was."
msgstr "Wcześniejsze okresy nadal liczą to, co liczyły, więc ich wyniki się nie zmieniają. Każda kwota zostaje bez zmian."

#: crates/kassensturz-ui-bridge/qml/TransactionPage.qml:408
#, kde-format
msgctxt "@info %1 is the longest a note may be"
msgid ""
"A note may be up to %1 characters long, so the rest did not fit. Please "
"shorten the note to add more."
msgstr "Notatka może mieć do %1 znaków, więc reszta się nie zmieściła. Skróć notatkę, aby dodać więcej."

#: crates/kassensturz-ui-bridge/qml/TransactionPage.qml:409
#, kde-format
msgctxt "@info %1 characters typed so far, %2 the longest a note may be"
msgid "%1 of %2 characters"
msgstr "%1 z %2 znaków"

#, kde-format
msgctxt ""
"@title:column a table of a candle chart: the day, week or month of a row"
msgid "Period"
msgstr "Okres"

#, kde-format
msgctxt ""
"@title:column a table of a candle chart: the highest balance at the end of a "
"day"
msgid "Highest"
msgstr "Najwyższe"

#, kde-format
msgctxt ""
"@title:column a table of a candle chart: the lowest balance at the end of a "
"day"
msgid "Lowest"
msgstr "Najniższe"

#, kde-format
msgctxt "@label legend of a candle chart"
msgid "Ended higher than it started"
msgstr "Zakończyło się wyżej, niż się zaczęło"

#, kde-format
msgctxt "@label legend of a candle chart"
msgid "Ended lower than it started"
msgstr "Zakończyło się niżej, niż się zaczęło"

#, kde-format
msgctxt "@label a balance of a candle: at the start of its days"
msgid "Start"
msgstr "Początek"

#, kde-format
msgctxt ""
"@label a balance of a candle: the highest at the end of one of its days"
msgid "Highest"
msgstr "Najwyższe"

#, kde-format
msgctxt ""
"@label a balance of a candle: the lowest at the end of one of its days"
msgid "Lowest"
msgstr "Najniższe"

#, kde-format
msgctxt "@label a balance of a candle: at the end of its days"
msgid "End"
msgstr "Koniec"

#, kde-format
msgctxt ""
"@label %1 is an amount of money: what the accounts held at the end of the "
"period"
msgid "Balance at the end: %1"
msgstr "Saldo na końcu: %1"

#, kde-format
msgctxt "@info under a candle chart"
msgid ""
"Each candle is one stretch of days, named below it. Its box runs from the "
"balance at the start to the balance at the end; the thin line runs from the "
"lowest to the highest balance at the end of a day. Several bookings on one "
"day count only with that day's end."
msgstr "Każda świeca to jeden odcinek dni, nazwany pod nią. Jej prostokąt biegnie od salda na początku do salda na końcu; cienka linia biegnie od najniższego do najwyższego salda na koniec dnia. Kilka zaksięgowań jednego dnia liczy się tylko ze stanem na koniec tego dnia."

#, kde-format
msgctxt ""
"@item:inlistbox a part of the layout: the balance per day, week or month "
"with its start, highest, lowest and end"
msgid "Balance candles"
msgstr "Świece salda"

#, kde-format
msgctxt "@title a candle chart of the accounts' balance"
msgid "How your balance moved"
msgstr "Jak zmieniało się Twoje saldo"

msgctxt "@item:inmenu a ready chart description"
msgid "Balance as bars, money in and out as lines"
msgstr "Saldo jako słupki, wpływy i wydatki jako linie"

#, kde-format
msgctxt "@item:inmenu a ready chart description"
msgid "What is left each month"
msgstr "Co zostaje każdego miesiąca"

#, kde-format
msgctxt "@item:inmenu a ready chart description"
msgid "Spending as a ring, by main category"
msgstr "Wydatki jako pierścień, według kategorii głównych"

#, kde-format
msgctxt "@item:inmenu a ready chart description"
msgid "What you are worth, with its average"
msgstr "Ile jesteś wart, ze średnią"

#, kde-format
msgctxt "@title"
msgid "Help: patterns, formulas and charts"
msgstr "Pomoc: wzorce, formuły i wykresy"

#, kde-format
msgctxt "@title:group"
msgid "Custom charts"
msgstr "Własne wykresy"

#, kde-format
msgctxt "@info"
msgid ""
"A custom chart is drawn from a short description in the Vega-Lite language: "
"which data to use, the kind of mark (bar, line, area, arc, point, text or "
"rule) and which field goes where. In the properties of a custom chart, "
"\"Insert an example\" puts one of the examples below into the field, where "
"you can change it. Nothing is kept until you choose \"Use this description\"."
msgstr "Własny wykres jest rysowany z krótkiego opisu w języku Vega-Lite: których danych użyć, jaki rodzaj znacznika (bar, line, area, arc, point, text lub rule) i które pole trafia gdzie. We właściwościach własnego wykresu „Wstaw przykład” umieszcza w polu jeden z poniższych przykładów, który możesz zmienić. Nic nie zostaje zachowane, dopóki nie wybierzesz „Użyj tego opisu”."

#, kde-format
msgctxt "@title:group"
msgid "Data names and their fields"
msgstr "Nazwy danych i ich pola"

#, kde-format
msgctxt "@info"
msgid ""
"Write the data name as \"data\": { \"name\": … }. Each name has the fields "
"listed after it. Amounts are exact; a chart never adds up different "
"currencies."
msgstr "Nazwę danych zapisz jako \"data\": { \"name\": … }. Każda nazwa ma pola wymienione po niej. Kwoty są dokładne; wykres nigdy nie sumuje różnych walut."

#, kde-format
msgctxt "@info what a data name of a chart description holds"
msgid "What you spent in the period, one row per category."
msgstr "Ile wydałeś w okresie, jeden wiersz na kategorię."

#, kde-format
msgctxt "@info what a data name of a chart description holds"
msgid "Money in and money out of each month, and what is left."
msgstr "Wpływy i wydatki każdego miesiąca oraz to, co zostaje."

#, kde-format
msgctxt "@info what a data name of a chart description holds"
msgid ""
"What each account held at the end of the period, and whether it is a debt or "
"closed."
msgstr "Ile było na każdym koncie na koniec okresu i czy to dług, czy konto zamknięte."

#, kde-format
msgctxt "@info what a data name of a chart description holds"
msgid "What you have, owe and are worth at the end of each month."
msgstr "Co masz, co jesteś winien i ile jesteś wart na koniec każdego miesiąca."

#, kde-format
msgctxt "@info what a data name of a chart description holds"
msgid ""
"For the chosen accounts together, each month's start, money in, money out, "
"net change and end."
