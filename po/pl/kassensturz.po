msgid "Credit card"
msgstr "Karta kredytowa"

#: crates/kassensturz-ui-bridge/qml/AccountTypes.qml:37
#, kde-format
msgctxt "@info"
msgid ""
"What you buy with it, you pay back later. KassenSturz shows what you owe on "
"it."
msgstr "To, co nią kupujesz, spłacasz później. KassenSturz pokazuje, ile jesteś na niej winien."

