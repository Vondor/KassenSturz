#, kde-format
msgctxt "@label:listbox"
msgid "Where the transaction goes"
msgstr "Dokąd trafia transakcja"

#: crates/kassensturz-ui-bridge/qml/RulePage.qml:339
#, kde-format
msgctxt "@info"
msgid ""
"The money is then moved between your own accounts, for example cash taken "
"out at a machine. It doesn't count as spending."
msgstr "Pieniądze są wtedy przenoszone między Twoimi własnymi kontami, na przykład gotówka wypłacona z bankomatu. Nie liczą się jako wydatek."

#: crates/kassensturz-ui-bridge/qml/RulePage.qml:346
#, kde-format
msgctxt "@label:textbox"
msgid "Show this name as From or To:"
msgstr "Pokaż tę nazwę jako „Od” lub „Dla”:"

#: crates/kassensturz-ui-bridge/qml/RulePage.qml:347
#, kde-format
msgctxt "@info:placeholder"
msgid "Leave empty to keep it"
msgstr "Zostaw puste, aby zachować"

#: crates/kassensturz-ui-bridge/qml/RulePage.qml:348
#, kde-format
