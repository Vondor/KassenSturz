msgid "Into a category"
msgstr "Do kategorii"

#: crates/kassensturz-ui-bridge/qml/RulePage.qml:311
#, kde-format
msgctxt ""
"@item:inlistbox the Rule moves the money to one of the user's accounts"
msgid "Move it to one of my accounts"
msgstr "Przenieś na jedno z moich kont"

#: crates/kassensturz-ui-bridge/qml/RulePage.qml:319
#, kde-format
msgctxt "@label:listbox"
msgid "What the Rule does with the transaction"
msgstr "Co reguła robi z transakcją"

