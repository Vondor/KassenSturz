msgstr "Wpisz kod TAN, który Twoja aplikacja TAN pokazuje dla tego logowania."

#: crates/kassensturz-ui-bridge/qml/BankDialogs.qml:43
#, kde-format
msgctxt "@title the made-up bank waits for an approval"
msgid "Waiting for approval"
msgstr "Czekam na zatwierdzenie"

#: crates/kassensturz-ui-bridge/qml/BankDialogs.qml:45
#, kde-format
