msgid "Column %1"
msgstr "Kolumna %1"

#: crates/kassensturz-ui-bridge/qml/CsvSettingsPage.qml:180
#, kde-format
msgctxt "@info %1 is a file name"
msgid ""
"%1 is a CSV file. Such a file doesn't say how it is written, and every bank "
"does it differently, so say once how to read your bank's files. KassenSturz "
"keeps the choices under the bank's name for the next file."
msgstr "%1 to plik CSV. Taki plik nie mówi, jak jest zapisany, a każdy bank robi to inaczej, więc raz określ, jak czytać pliki Twojego banku. KassenSturz zapamięta te wybory pod nazwą banku na następny plik."

#: crates/kassensturz-ui-bridge/qml/CsvSettingsPage.qml:188
#, kde-format
