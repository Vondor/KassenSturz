#: crates/kassensturz-ui-bridge/qml/PlanFormDialog.qml:327
#, kde-format
msgctxt "@info %1 is a list of dates"
msgid "Next: %1"
msgstr "Następne: %1"

#: crates/kassensturz-ui-bridge/qml/PlanFormDialog.qml:328
#, kde-format
msgctxt "@info"
msgid "Next: no date yet. Check how often and the first date."
