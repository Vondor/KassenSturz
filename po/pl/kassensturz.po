#: crates/kassensturz-ui-bridge/qml/TransactionPage.qml:220
#, kde-format
msgctxt "@option:radio"
msgid "I paid money"
msgstr "Zapłaciłem"

#: crates/kassensturz-ui-bridge/qml/PartsPage.qml:173
#: crates/kassensturz-ui-bridge/qml/TransactionPage.qml:231
#, kde-format
msgctxt "@option:radio"
msgid "I received money"
msgstr "Otrzymałem pieniądze"

#: crates/kassensturz-ui-bridge/qml/PartsPage.qml:184
#, kde-format
msgctxt "@label:textbox"
msgid "How much in all?"
msgstr "Ile łącznie?"

#: crates/kassensturz-ui-bridge/qml/PartsPage.qml:198
#, kde-format
msgctxt "@info"
msgid ""
"This transaction came from your bank, so the total stays as the bank sent "
"it. You can change the parts."
msgstr "Ta transakcja pochodzi z Twojego banku, więc suma zostaje taka, jaką przysłał bank. Części możesz zmienić."

