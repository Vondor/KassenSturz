#, kde-format
msgctxt "@label:textbox %1 is the number of the part"
msgid "How much of it part %1 was"
msgstr "Ile wynosiła część %1"

#: crates/kassensturz-ui-bridge/qml/PartRow.qml:101
#, kde-format
msgctxt "@action:button"
msgid "Remove this part"
msgstr "Usuń tę część"

#: crates/kassensturz-ui-bridge/qml/PartRow.qml:117
#, kde-format
msgctxt ""
"@info %1 is an amount of money without its currency, %2 is the number of the "
"part"
msgid "Part %2 gets what is left: %1"
msgstr "Część %2 dostaje resztę: %1"

#: crates/kassensturz-ui-bridge/qml/PartRow.qml:127
#, kde-format
msgctxt "@label:textbox %1 is a currency code"
msgid "In %1:"
msgstr "W %1:"

#: crates/kassensturz-ui-bridge/qml/PartRow.qml:137
#, kde-format
msgctxt "@label:textbox %1 is the number of the part, %2 a currency code"
msgid "What part %1 was in %2"
msgstr "Ile wynosiła część %1 w %2"

#: crates/kassensturz-ui-bridge/qml/PartRow.qml:150
#, kde-format
msgctxt "@info %1 and %3 are currency codes, %2 an exchange rate"
msgid "1 %1 = %2 %3"
msgstr "1 %1 = %2 %3"

#: crates/kassensturz-ui-bridge/qml/PartRow.qml:151
