#: crates/kassensturz-ui-bridge/qml/PartRow.qml:160
#, kde-format
msgctxt "@info %1 is a currency code"
msgid ""
"Your book has no exchange rate for %1 yet, so type what this part was in %1, "
"e.g. from the receipt."
msgstr "Twoja księga nie ma jeszcze kursu wymiany dla %1, więc wpisz, ile wynosiła ta część w %1, np. z paragonu."

#: crates/kassensturz-ui-bridge/qml/PartsPage.qml:45
#, kde-format
msgctxt "@title"
msgid "Break down this transaction"
msgstr "Rozbij tę transakcję"

#: crates/kassensturz-ui-bridge/qml/PartsPage.qml:153
#, kde-format
msgctxt "@info"
msgid ""
"Say what each part of this transaction was for. Leave one part's amount "
"empty, and KassenSturz works it out from the rest."
msgstr "Podaj, na co była każda część tej transakcji. Zostaw kwotę jednej części pustą, a KassenSturz wyliczy ją z reszty."

#: crates/kassensturz-ui-bridge/qml/PartsPage.qml:162
#: crates/kassensturz-ui-bridge/qml/TransactionPage.qml:219
#, kde-format
msgctxt "@label"
msgid "What happened?"
msgstr "Co się stało?"

